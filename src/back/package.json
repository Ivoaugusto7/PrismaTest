{
  "name": "prolaje-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do PROLAJE/Casa Lajes em Node.js, Express, TypeScript, Prisma e PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "node --test --import tsx test/**/*.test.ts",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "morgan": "1.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.2",
    "prisma": "6.19.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
"engines": {
  "node": "22.x"
}
}
