# URL base da API REST. Deixe vazio para usar o fallback local em localStorage.
# Exemplo em produção: https://api.casalajes.com.br
VITE_API_BASE_URL=

# Timeout das requisições REST em milissegundos.
VITE_API_TIMEOUT_MS=8000

# Quando true, a aplicação continua funcionando com localStorage se a API não estiver configurada ou indisponível.
VITE_USE_LOCAL_FALLBACK=true
